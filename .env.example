# Environment Configuration Example
# Pharmacy Smart Restocking & Vendor Negotiation Agent

# Negotiator configuration: 'rule_based' (default, no API key needed) or 'llm'
NEGOTIATOR_PROVIDER=rule_based

# Optional: Add Gemini API key if using LLM provider
GEMINI_API_KEY=

# Database configuration
DATABASE_URL=sqlite:///./pharmacy.db

# Server port
PORT=8000
